// Glitter Hits — Prisma schema
// PostgreSQL in production (Neon). Local agents may temporarily use sqlite for UI verification.
// Credits are ALWAYS integer Glitter Hits units — never floats / never Glitter Coins.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth / Users ───────────────────────────────────────────────────────────

enum UserRole {
  member
  moderator
  admin
  founder
}

enum MembershipTier {
  free
  plus
  premium
  vip
}

model User {
  id               String         @id @default(cuid())
  name             String?
  email            String         @unique
  emailVerified    DateTime?
  passwordHash     String?
  image            String?
  role             UserRole       @default(member)
  membership       MembershipTier @default(free)
  bio              String?
  countryCode      String?
  // Integer Glitter Hits balance (promotional credits, NOT crypto / NOT Glitter Coins)
  creditBalance    Int            @default(0)
  lifetimeEarned   Int            @default(0)
  lifetimeSpent    Int            @default(0)
  levelSlug        String         @default("newcomer")
  levelPoints      Int            @default(0)
  // Glitter Luck Engine
  luckPoints       Int            @default(0)
  luckLevelSlug    String         @default("spark")
  wheelSpins       Int            @default(0)
  questTokens      Int            @default(0)
  personaId        String?
  lastActiveDate   String? // YYYY-MM-DD UTC for meaningful activity
  boostMultiplier  Int            @default(100) // percent, 100 = 1x
  boostExpiresAt   DateTime?
  profilePublic    Boolean        @default(true)
  streakDays       Int            @default(0)
  longestStreak    Int            @default(0)
  lastSurfDate     DateTime?
  referralCode     String         @unique
  referredById     String?
  referredBy       User?          @relation("Referrals", fields: [referredById], references: [id])
  referrals        User[]         @relation("Referrals")
  riskScore        Int            @default(0)
  isSuspended      Boolean        @default(false)
  suspendedReason  String?
  onboardingDoneAt DateTime?
  // Stripe billing (cash packs + membership subscriptions)
  stripeCustomerId            String?   @unique
  stripeSubscriptionId        String?   @unique
  stripeSubscriptionStatus    String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  persona          Persona?       @relation(fields: [personaId], references: [id], onDelete: SetNull)
  purchases        StripePurchase[]
  accounts         Account[]
  sessions         Session[]
  websites         Website[]
  campaigns        Campaign[]
  ledgerEntries    CreditLedger[]
  surfSessions     SurfSession[]
  visitsGiven      Visit[]        @relation("VisitorVisits")
  visitsReceived   Visit[]        @relation("OwnerVisits")
  achievements     UserAchievement[]
  referralsMade    ReferralEvent[] @relation("ReferrerEvents")
  referralsAsUser  ReferralEvent[] @relation("ReferredEvents")
  reportsFiled     SiteReport[]   @relation("Reporter")
  adminLogs        AdminAuditLog[]
  dailyRewards     DailyRewardClaim[]
  notifications    Notification[]
  mailsSent        MailCampaign[] @relation("MailSender")
  mailReceipts     MailReceipt[]  @relation("MailRecipient")
  luckLedger       LuckLedger[]
  userQuests       UserQuest[]
  glitterDrops     GlitterDrop[]
  jackpotWins      JackpotWin[]
  wheelSpinsLog    WheelSpin[]
  userBadges       UserBadge[]
  challengeParts   ChallengeContribution[]
  rewardEvents     RewardEvent[]
  streakClaims     StreakMilestoneClaim[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─── Credits ────────────────────────────────────────────────────────────────

enum CreditTxnType {
  earned_surf
  earned_automated
  earned_bonus
  earned_daily
  earned_weekly
  earned_streak
  earned_achievement
  earned_referral
  earned_promo
  earned_drop
  earned_jackpot
  earned_wheel
  earned_quest
  earned_challenge
  spent_campaign
  spent_featured
  spent_boost
  spent_mail
  spent_mail_upgrade
  admin_adjustment
  purchase // cash pack purchases when Stripe enabled
  refund
}

model CreditLedger {
  id            String        @id @default(cuid())
  userId        String
  // Positive = credit, negative = debit. Integer only.
  amount        Int
  balanceAfter  Int
  type          CreditTxnType
  description   String
  // Optional references (stored as strings for SQLite flexibility)
  campaignId    String?
  visitId       String?
  referralId    String?
  achievementId String?
  metadataJson  String        @default("{}")
  createdAt     DateTime      @default(now())
  createdById   String? // admin actor when adjustment

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

// ─── Categories / Tags / Brands ─────────────────────────────────────────────

model Category {
  id          String    @id @default(cuid())
  slug        String    @unique
  name        String
  description String?
  icon        String?
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  isAdult     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  websites    Website[]
}

model Tag {
  id       String        @id @default(cuid())
  slug     String        @unique
  name     String
  websites WebsiteTag[]
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  url         String
  description String?
  logoUrl     String?
  category    String?
  network     String   @default("founder") // founder | partner | community
  isFeatured  Boolean  @default(false)
  isEnabled   Boolean  @default(true)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ─── Websites & Campaigns ───────────────────────────────────────────────────

enum ModerationStatus {
  pending
  approved
  rejected
  suspended
  blocked
}

enum CampaignStatus {
  draft
  active
  paused
  exhausted
  archived
  deleted
}

enum DeliveryMode {
  fastest
  evenly
  custom
}

enum PriorityTier {
  standard
  boosted
  featured
  premium
}

enum DeviceTarget {
  all
  desktop
  mobile
  tablet
}

model Website {
  id               String           @id @default(cuid())
  userId           String
  url              String
  title            String
  description      String?
  thumbnailUrl     String?
  faviconUrl       String?
  categoryId       String?
  moderationStatus ModerationStatus @default(pending)
  moderationNotes  String?
  isQueerdomPick   Boolean          @default(false)
  isFeatured       Boolean          @default(false)
  isTrending       Boolean          @default(false)
  discoverCount    Int              @default(0)
  reportCount      Int              @default(0)
  httpsOk          Boolean          @default(false)
  lastCheckedAt    DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category?      @relation(fields: [categoryId], references: [id])
  tags      WebsiteTag[]
  campaigns Campaign[]
  reports   SiteReport[]
  placements FeaturedPlacement[]

  @@index([userId])
  @@index([moderationStatus])
  @@index([isQueerdomPick])
  @@index([isFeatured])
}

model WebsiteTag {
  websiteId String
  tagId     String
  website   Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([websiteId, tagId])
}

model Campaign {
  id              String         @id @default(cuid())
  userId          String
  websiteId       String
  name            String
  status          CampaignStatus @default(draft)
  // Credits allocated to this campaign (integer)
  creditBalance   Int            @default(0)
  creditsSpent    Int            @default(0)
  visitDurationSec Int           @default(15)
  maxVisits       Int?
  dailyVisitCap   Int?
  hourlyVisitCap  Int?
  frequencyCapHours Int          @default(24) // same viewer cooldown
  priority        PriorityTier   @default(standard)
  deliveryMode    DeliveryMode   @default(evenly)
  // Targeting stored as JSON strings for SQLite
  geoTargetsJson  String         @default("[\"WW\"]") // WW = worldwide, or ISO country codes
  regionTargetsJson String       @default("[]")
  deviceTarget    DeviceTarget   @default(all)
  scheduleJson    String         @default("{\"mode\":\"always\"}")
  startAt         DateTime?
  endAt           DateTime?
  visitsDelivered Int            @default(0)
  uniqueVisitors  Int            @default(0)
  estimatedDaily  Int? // network-based estimate, not a guarantee
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  website Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  visits  Visit[]

  @@index([status, priority])
  @@index([userId])
  @@index([websiteId])
}

// ─── Surf / Delivery / Visits ───────────────────────────────────────────────

enum ViewerType {
  human_exchange
  automated_viewer
  admin_test
}

enum VisitQuality {
  human_exchange
  automated_viewer
  suspicious
  blocked
  admin_test
}

enum SurfSessionStatus {
  active
  paused
  completed
  aborted
}

model SurfSession {
  id              String            @id @default(cuid())
  userId          String
  status          SurfSessionStatus @default(active)
  viewerType      ViewerType        @default(human_exchange)
  creditsEarned   Int               @default(0)
  sitesViewed     Int               @default(0)
  sitesSkipped    Int               @default(0)
  startedAt       DateTime          @default(now())
  endedAt         DateTime?
  lastHeartbeatAt DateTime          @default(now())
  ipHash          String?
  userAgentHash   String?
  deviceHint      String? // desktop | mobile | tablet
  countryCode     String?
  riskFlagsJson   String            @default("[]")

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  visits Visit[]

  @@index([userId, startedAt])
  @@index([status])
}

model Visit {
  id              String       @id @default(cuid())
  campaignId      String
  websiteId       String
  ownerUserId     String
  visitorUserId   String?
  surfSessionId   String?
  quality         VisitQuality @default(human_exchange)
  viewerType      ViewerType   @default(human_exchange)
  requiredDurationSec Int
  actualDurationSec   Int      @default(0)
  completed       Boolean      @default(false)
  credited        Boolean      @default(false)
  creditsCharged  Int          @default(0)
  creditsEarned   Int          @default(0)
  countryCode     String?
  deviceHint      String?
  sourceLabel     String       @default("glitter_hits_exchange") // honest labeling
  skipped         Boolean      @default(false)
  reported        Boolean      @default(false)
  startedAt       DateTime     @default(now())
  completedAt     DateTime?

  campaign    Campaign     @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  owner       User         @relation("OwnerVisits", fields: [ownerUserId], references: [id], onDelete: Cascade)
  visitor     User?        @relation("VisitorVisits", fields: [visitorUserId], references: [id], onDelete: SetNull)
  surfSession SurfSession? @relation(fields: [surfSessionId], references: [id], onDelete: SetNull)

  @@index([campaignId, startedAt])
  @@index([visitorUserId, campaignId, startedAt])
  @@index([ownerUserId, startedAt])
  @@index([quality, startedAt])
}

// Frequency tracking: last time a viewer saw a campaign
model CampaignViewerCooldown {
  id           String   @id @default(cuid())
  campaignId   String
  viewerUserId String
  lastSeenAt   DateTime @default(now())

  @@unique([campaignId, viewerUserId])
  @@index([viewerUserId, lastSeenAt])
}

// ─── Gamification ───────────────────────────────────────────────────────────

model LevelDefinition {
  id          String @id @default(cuid())
  slug        String @unique
  name        String
  minPoints   Int
  sortOrder   Int    @default(0)
  badgeEmoji  String?
  description String?
}

model AchievementDefinition {
  id           String            @id @default(cuid())
  slug         String            @unique
  name         String
  description  String
  icon         String?
  creditReward Int               @default(0)
  pointsReward Int               @default(0)
  isActive     Boolean           @default(true)
  criteriaJson String            @default("{}")
  users        UserAchievement[]
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  earnedAt      DateTime @default(now())

  user        User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}

model DailyRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  claimDate String // YYYY-MM-DD UTC
  amount    Int
  streakDay Int
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, claimDate])
}

// ─── Referrals ──────────────────────────────────────────────────────────────

enum ReferralStatus {
  clicked
  registered
  activated
  qualified
  rejected
}

model ReferralEvent {
  id              String         @id @default(cuid())
  referrerId      String
  referredUserId  String?
  code            String
  status          ReferralStatus @default(clicked)
  creditsAwarded  Int            @default(0)
  ipHash          String?
  createdAt       DateTime       @default(now())
  activatedAt     DateTime?
  qualifiedAt     DateTime?

  referrer User  @relation("ReferrerEvents", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User? @relation("ReferredEvents", fields: [referredUserId], references: [id], onDelete: SetNull)

  @@index([referrerId, status])
  @@index([code])
}

// ─── Featured / Promotional inventory ───────────────────────────────────────

enum PlacementType {
  featured_site
  homepage_spotlight
  category_spotlight
  trending_placement
  banner_ad
  text_ad
  newsletter
  sponsored_discovery
}

enum PlacementStatus {
  draft
  scheduled
  active
  paused
  expired
  disabled
}

model FeaturedPlacement {
  id         String          @id @default(cuid())
  websiteId  String?
  brandId    String?
  type       PlacementType
  status     PlacementStatus @default(disabled)
  title      String?
  body       String?
  imageUrl   String?
  targetUrl  String?
  creditCost Int             @default(0)
  startAt    DateTime?
  endAt      DateTime?
  sortOrder  Int             @default(0)
  metadataJson String        @default("{}")
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  website Website? @relation(fields: [websiteId], references: [id], onDelete: SetNull)

  @@index([type, status])
}

// ─── Moderation ─────────────────────────────────────────────────────────────

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

model SiteReport {
  id          String       @id @default(cuid())
  websiteId   String
  reporterId  String
  reason      String
  details     String?
  status      ReportStatus @default(open)
  resolution  String?
  createdAt   DateTime     @default(now())
  resolvedAt  DateTime?

  website  Website @relation(fields: [websiteId], references: [id], onDelete: Cascade)
  reporter User    @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt])
}

model AdminAuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String
  targetType String?
  targetId   String?
  detailsJson String  @default("{}")
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id], onDelete: Cascade)

  @@index([createdAt])
}

// ─── System settings (admin-configurable economics) ─────────────────────────

model SystemSetting {
  key       String   @id
  valueJson String
  updatedAt DateTime @updatedAt
  updatedBy String?
}

model Announcement {
  id        String    @id @default(cuid())
  title     String
  body      String
  isActive  Boolean   @default(true)
  startsAt  DateTime?
  endsAt    DateTime?
  createdAt DateTime  @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  /// bug | suggestion | feature | theme | website | love | other | contact
  category  String   @default("contact")
  userId    String?
  rewarded  Boolean  @default(false)
  ipHash    String?
  status    String   @default("new")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
  @@index([category])
  @@index([userId, createdAt])
}

model MonetizationFeature {
  key         String  @id
  name        String
  description String?
  enabled     Boolean @default(false)
  configJson  String  @default("{}")
}

// ─── Notifications ──────────────────────────────────────────────────────────

model Notification {
  id        String    @id @default(cuid())
  userId    String
  type      String
  title     String
  body      String
  href      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

// ─── Credit store packs (cash checkout when enabled) ────────────────────────

model CreditPack {
  id            String  @id @default(cuid())
  slug          String  @unique
  name          String
  description   String?
  credits       Int
  priceCents    Int
  badge         String?
  stripePriceId String?
  isActive      Boolean @default(true)
  sortOrder     Int     @default(0)
  createdAt     DateTime @default(now())
}

enum StripePurchaseKind {
  credit_pack
  membership
}

enum StripePurchaseStatus {
  pending
  paid
  refunded
  failed
}

model StripePurchase {
  id                    String               @id @default(cuid())
  userId                String
  kind                  StripePurchaseKind
  status                StripePurchaseStatus @default(pending)
  amountCents           Int
  currency              String               @default("usd")
  creditPackSlug        String?
  creditsGranted        Int?
  membershipTier        MembershipTier?
  stripeSessionId       String               @unique
  stripePaymentIntentId String?
  stripeSubscriptionId  String?
  metadataJson          String               @default("{}")
  fulfilledAt           DateTime?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([status, kind])
}

// ─── Member mailing / solo ads ──────────────────────────────────────────────

enum MailTier {
  standard
  boosted
  featured
  premium_solo
}

enum MailStatus {
  draft
  queued
  sent
  cancelled
}

model MailCampaign {
  id              String     @id @default(cuid())
  senderId        String
  subject         String
  body            String
  ctaUrl          String?
  ctaLabel        String?
  tier            MailTier   @default(standard)
  status          MailStatus @default(draft)
  creditCost      Int        @default(0)
  upgradeCreditCost Int      @default(0)
  recipientCount  Int        @default(0)
  readCount       Int        @default(0)
  // Paid solo upgrade purchased with credits (cash Stripe hook later)
  isPaidSolo      Boolean    @default(false)
  createdAt       DateTime   @default(now())
  sentAt          DateTime?

  sender     User          @relation("MailSender", fields: [senderId], references: [id], onDelete: Cascade)
  receipts   MailReceipt[]

  @@index([senderId, createdAt])
  @@index([status, createdAt])
  @@index([tier, sentAt])
}

model MailReceipt {
  id          String    @id @default(cuid())
  mailId      String
  recipientId String
  isFeatured  Boolean   @default(false)
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  mail      MailCampaign @relation(fields: [mailId], references: [id], onDelete: Cascade)
  recipient User         @relation("MailRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@unique([mailId, recipientId])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt])
}

// ─── Glitter Luck Engine ────────────────────────────────────────────────────

enum RewardRarity {
  common
  uncommon
  rare
  epic
  diamond
}

enum QuestStatus {
  active
  completed
  claimed
  expired
}

enum ChallengeStatus {
  draft
  active
  completed
  expired
  cancelled
}

model LuckLevelDefinition {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  minLuck     Int
  sortOrder   Int     @default(0)
  icon        String  @default("✨")
  description String?
  isActive    Boolean @default(true)
}

model LuckLedger {
  id           String   @id @default(cuid())
  userId       String
  amount       Int
  balanceAfter Int
  source       String
  description  String
  metadataJson String   @default("{}")
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([source, createdAt])
}

model QuestDefinition {
  id              String       @id @default(cuid())
  slug            String       @unique
  name            String
  description     String
  icon            String       @default("🎯")
  rarity          RewardRarity @default(common)
  requirementJson String       @default("{}")
  rewardHits      Int          @default(0)
  rewardLuck      Int          @default(0)
  rewardSpins     Int          @default(0)
  rewardTokens    Int          @default(0)
  rewardBadgeSlug String?
  isRepeatable    Boolean      @default(false)
  isActive        Boolean      @default(true)
  sortOrder       Int          @default(0)
  startsAt        DateTime?
  endsAt          DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  userQuests UserQuest[]
}

model UserQuest {
  id          String      @id @default(cuid())
  userId      String
  questId     String
  status      QuestStatus @default(active)
  progress    Int         @default(0)
  target      Int         @default(1)
  completedAt DateTime?
  claimedAt   DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest QuestDefinition @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@unique([userId, questId])
  @@index([userId, status])
}

model StreakMilestone {
  id          String  @id @default(cuid())
  days        Int     @unique
  name        String
  description String?
  rewardHits  Int     @default(0)
  rewardLuck  Int     @default(0)
  rewardSpins Int     @default(0)
  badgeSlug   String?
  isActive    Boolean @default(true)
}

model StreakMilestoneClaim {
  id          String   @id @default(cuid())
  userId      String
  milestoneId String
  claimedAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneId])
}

model Persona {
  id              String  @id @default(cuid())
  slug            String  @unique
  name            String
  description     String
  icon            String
  accentColor     String  @default("#ff4fd8")
  unlockLuckMin   Int     @default(0)
  unlockQuestSlug String?
  isActive        Boolean @default(true)
  sortOrder       Int     @default(0)
  users           User[]
}

model BadgeDefinition {
  id           String       @id @default(cuid())
  slug         String       @unique
  name         String
  description  String
  icon         String       @default("✨")
  rarity       RewardRarity @default(common)
  criteriaJson String       @default("{}")
  isActive     Boolean      @default(true)
  sortOrder    Int          @default(0)
  users        UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge BadgeDefinition @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

model GlitterDrop {
  id           String       @id @default(cuid())
  userId       String
  rarity       RewardRarity @default(common)
  rewardType   String
  rewardValue  Int          @default(0)
  rewardLabel  String
  status       String       @default("pending")
  expiresAt    DateTime
  claimedAt    DateTime?
  metadataJson String       @default("{}")
  createdAt    DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status, expiresAt])
}

model JackpotWin {
  id          String   @id @default(cuid())
  userId      String
  rewardType  String
  rewardValue Int
  rewardLabel String
  source      String   @default("activity")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([createdAt])
}

model WheelSegment {
  id          String       @id @default(cuid())
  label       String
  rewardType  String
  rewardValue Int          @default(0)
  weight      Int          @default(10)
  rarity      RewardRarity @default(common)
  color       String       @default("#ff4fd8")
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)
}

model WheelSpin {
  id          String   @id @default(cuid())
  userId      String
  clientKey   String
  segmentId   String?
  rewardType  String
  rewardValue Int
  rewardLabel String
  processed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, clientKey])
  @@index([userId, createdAt])
}

model CommunityChallenge {
  id              String          @id @default(cuid())
  slug            String          @unique
  name            String
  description     String
  icon            String          @default("🌈")
  metric          String
  goal            Int
  progress        Int             @default(0)
  rewardHits      Int             @default(0)
  status          ChallengeStatus @default(draft)
  startsAt        DateTime?
  endsAt          DateTime?
  completedAt     DateTime?
  eligibilityJson String          @default("{\"requireActive\":true}")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  contributions ChallengeContribution[]
}

model ChallengeContribution {
  id          String   @id @default(cuid())
  challengeId String
  userId      String
  amount      Int      @default(1)
  rewarded    Boolean  @default(false)
  createdAt   DateTime @default(now())

  challenge CommunityChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)
  user      User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([challengeId, userId])
  @@index([userId])
}

model RoyaltyCategory {
  id          String  @id @default(cuid())
  slug        String  @unique
  name        String
  description String?
  metric      String
  icon        String  @default("👑")
  isActive    Boolean @default(true)
  sortOrder   Int     @default(0)
  rotateDays  Int     @default(7)
}

model RewardEvent {
  id          String   @id @default(cuid())
  userId      String
  kind        String
  title       String
  body        String
  payloadJson String   @default("{}")
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
