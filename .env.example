# Glitter Hits — Environment
# Copy to .env and fill in values. Never commit .env.

# Local SQLite is no longer used — Postgres required (local Docker / Neon / Vercel).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/glitterhits?schema=public"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App URL — local:
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Production (Vercel):
# AUTH_URL="https://glitterhits.online"
# NEXT_PUBLIC_APP_URL="https://glitterhits.online"

# Seed (local). Production seed requires SEED_MODE=production + strong SEED_ADMIN_PASSWORD.
# SEED_ADMIN_EMAIL="you@glitterhits.online"
# SEED_ADMIN_PASSWORD=
# SEED_RESET_ADMIN_PASSWORD="false"
# ALLOW_DEMO_SEED="true"

# Transactional email (Resend) — required for production password reset (needs domain DNS)
# RESEND_API_KEY=
# EMAIL_FROM="Glitter Hits <noreply@glitterhits.online>"
# SUPPORT_EMAIL="hello@glitterhits.online"

# Vercel Cron auth for /api/cron/weekly — required in production
CRON_SECRET="replace-with-a-long-random-secret"

# Cloudflare Turnstile — create widget for your production hostname in Cloudflare dashboard.
# When keys are set, verification is enforced. Set REQUIRE_TURNSTILE=true to fail closed if keys are missing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# REQUIRE_TURNSTILE="true"
# ALLOW_INSECURE_AUTH="false"

# Site moderation: default queues new sites for human review.
# Set true only for trusted local/dev auto-approve.
# MODERATION_AUTO_APPROVE="true"

# Stripe Checkout (credit packs + membership subscriptions)
# Use restricted key (rk_) in production when possible. Sandbox keys work for local/dev.
# STRIPE_SECRET_KEY=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
# Stripe Price IDs (created in Dashboard or via CLI) — optional if packs have stripePriceId in DB
# STRIPE_PRICE_PACK_STARTER=
# STRIPE_PRICE_PACK_BOOST=
# STRIPE_PRICE_PACK_LAUNCH=
# STRIPE_PRICE_PACK_EMPIRE=
# STRIPE_PRICE_MEMBERSHIP_PLUS=
# STRIPE_PRICE_MEMBERSHIP_PREMIUM=
# STRIPE_PRICE_MEMBERSHIP_VIP=
