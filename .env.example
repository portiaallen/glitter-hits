# Glitter Hits — Environment
# Copy to .env and fill in values. Never commit .env.

# SQLite (local). For production, use a Postgres URL.
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App URL
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional: password-reset email (if unset, reset links are logged / shown in non-SMTP mode)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Glitter Hits <noreply@glitterhits.gay>"

# Optional: Vercel Cron auth for /api/cron/weekly
# CRON_SECRET="replace-me"
