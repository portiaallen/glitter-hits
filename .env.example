# Glitter Hits — Environment
# Copy to .env and fill in values. Never commit .env.

# Local SQLite. Production must use Postgres (Neon / Vercel Postgres / etc.).
DATABASE_URL="file:./dev.db"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"

# App URL
AUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Seed (local). Production seed requires SEED_MODE=production + strong SEED_ADMIN_PASSWORD.
# SEED_ADMIN_EMAIL="you@example.com"
# SEED_ADMIN_PASSWORD=
# SEED_RESET_ADMIN_PASSWORD="false"
# ALLOW_DEMO_SEED="true"

# Transactional email (Resend) — required for production password reset
# RESEND_API_KEY=
# EMAIL_FROM="Glitter Hits <noreply@glitterhits.gay>"
# SUPPORT_EMAIL="hello@glitterhits.gay"

# Vercel Cron auth for /api/cron/weekly — required in production
# CRON_SECRET=

# Cloudflare Turnstile — set both keys for launch bot protection.
# When keys are set, verification is enforced. Set REQUIRE_TURNSTILE=true to fail closed if keys are missing.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# REQUIRE_TURNSTILE="true"
# ALLOW_INSECURE_AUTH="false"

# Site moderation: default queues new sites for human review.
# Set true only for trusted local/dev auto-approve.
# MODERATION_AUTO_APPROVE="true"
